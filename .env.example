# Скопируй в .env. Секретов в репозитории нет, всё необязательно.

# Порог уверенности ответа из базы знаний (0..1)
KB_MIN_SCORE=0.5
# Для метрики «сэкономлено минут наставника»
MINUTES_SAVED_PER_ANSWER=10
MAX_LEAVE_DAYS=14
TOKEN_TTL_HOURS=12

# Если задан, работает POST /api/internal/cron/digest (заголовок X-Cron-Token)
CRON_TOKEN=

# LLM (необязательно). По умолчанию отключён: ответы берутся из базы знаний.
# Провайдеры: anthropic или openai (любой OpenAI-совместимый сервер через LLM_BASE_URL)
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT=8
